# Google Gemini API key (Required for AI analysis)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ServiceNow Instance Credentials (Optional / for incident synchronization)
# Supports SERVICENOW_* or SN_* aliases
# If your password contains special characters (# = $ /), wrap it in single quotes
SERVICENOW_INSTANCE=https://devXXXXX.service-now.com
SERVICENOW_USERNAME=admin
SERVICENOW_PASSWORD='your_servicenow_password_here'
